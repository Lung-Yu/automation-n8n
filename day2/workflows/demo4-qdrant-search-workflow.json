      "parameters": {
        "jsCode": "const results = $input.item.json.result || [];\nconst question = $('Demo Question').item.json.question;\nconsole.log('Question:', question);\nresults.forEach((r, i) => {\n  console.log(`[${i+1}] score=${r.score.toFixed(4)} ${r.payload.source} > ${r.payload.section}`);\n  console.log(`     ${r.payload.text.slice(0,60)}...`);\n});\nreturn [{ json: { question, top3: results.map(r => ({\n  score: r.score.toFixed(4),\n  source: r.payload.source,\n  section: r.payload.section,\n  text: r.payload.text\n})) }}];"
