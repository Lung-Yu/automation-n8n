    {
      "id": "lb1-gemini",
      "name": "Gemini：分析 Log",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        464,
        304
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "models/gemini-2.5-flash",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "content": "={{ \"你是一位 IT 維運工程師，負責分析系統 log。\\n\\n以下是一段系統 log：\\n---\\n\" + ($json.body?.log_text || $json.log_text || '') + \"\\n---\\n\\n請分析並只回傳以下 JSON（不要任何其他文字、不要 markdown ``` 包裹）：\\n{\\n  \\\"severity\\\": \\\"Critical\\\",\\n  \\\"root_cause\\\": \\\"可能原因（一行，15字以內）\\\",\\n  \\\"actions\\\": [\\\"建議動作 1\\\", \\\"建議動作 2\\\", \\\"建議動作 3\\\"]\\n}\\n\\nseverity 只能從這四個值選一個：Critical, High, Medium, Low\" }}",
              "role": "user"
            }
          ]
        },
        "simplifyOutput": true
      },
      "credentials": {
        "googlePalmApi": {
          "id": "y5KQga469O9gMXCo",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const text = $input.item.json.content?.parts?.[0]?.text || $input.item.json.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\nconst clean = text.replace(/```json\\n?|```/g, '').trim();\nlet parsed = {};\ntry { parsed = JSON.parse(clean); } catch(e) { parsed = {severity:'Medium', root_cause:'Parse error', actions: text}; }\nconst logText = $input.item.json.log_text || '';\nreturn [{ json: {\n  severity:    parsed.severity   || 'Medium',\n  root_cause:  parsed.root_cause || '',\n  actions:     parsed.actions    || '',\n  original_log: logText\n} }];"
      },
      "id": "lb1-parse",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.severity }}",
              "rightValue": "Critical",
