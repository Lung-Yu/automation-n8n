    {
      "parameters": {
        "jsCode": "// Demo 用通知：改 severity 為 'info' 可測一般訊息路徑\nreturn [{ json: {\n  source: 'demo',\n  severity: 'critical',\n  title: '通知中心測試',\n  message: '這是一則來自 Demo Trigger 的測試通知'\n} }];"
      },
      "id": "adv0-demo",
      "name": "Demo 通知",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        512
      ]
    },
    {
      "parameters": {
        "jsCode": "// 支援 Webhook（$json.body）與 Demo 路徑；欄位缺漏給安全預設\nconst b = $json.body?.title ? $json.body : $json;\nreturn [{ json: {\n  source: b.source || 'unknown',\n  severity: (b.severity || 'info').toLowerCase(),\n  title: b.title || '(無標題)',\n  message: b.message || ''\n} }];"
      },
