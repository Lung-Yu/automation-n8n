    {
      "id": "e-try",
      "name": "Try: 驗證與處理",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        480
      ],
      "continueOnFail": true,
      "parameters": {
        "jsCode": "const input = $input.item.json.body || $input.item.json;\nif (!input.required_field) {\n  throw new Error('Missing required_field in payload');\n}\nreturn [{ json: { status: 'ok', processed: input.required_field, timestamp: new Date().toISOString() } }];"
      }
    },
    {
      "id": "e-if",
      "name": "IF: 是否出錯？",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        480
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and",
          "options": {}
        },
        "options": {}
      }
    },
    {
      "id": "e-catch",
      "name": "Catch: 錯誤處理",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        380
      ],
      "parameters": {
        "jsCode": "const errMsg = $input.item.json.error || 'Unknown error';\nconsole.log('Error caught:', errMsg);\nreturn [{ json: {\n  result:     'error',\n  error_msg:  errMsg,\n  timestamp:  new Date().toISOString(),\n  suggestion: '請確認 payload 包含 required_field 欄位'\n} }];"
      }
    },
    {
      "id": "e-ok",
      "name": "Success: 處理完成",
