    "dataTableId": {
     "__rl": true,
     "value": "ugxG71SPRX07tKKV",
     "mode": "id",
     "cachedResultName": "alert_dedup"
    },
    "matchType": "anyCondition",
    "filters": {
     "conditions": [
      {
       "keyName": "alert_key",
       "condition": "eq",
       "keyValue": "={{ $('Code: 組告警指紋').item.json.alert_key }}"
      }
     ]
    },
    "columns": {
     "mappingMode": "defineBelow",
     "value": {
      "alert_key": "={{ $('Code: 組告警指紋').item.json.alert_key }}",
      "last_seen": "={{ $('Code: 組告警指紋').item.json.now }}",
      "count": 1
     },
