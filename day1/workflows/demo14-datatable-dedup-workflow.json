   "parameters": {
    "method": "POST",
    "url": "http://host.containers.internal:3001/api/notify",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ channel: \"ops\", message: `[${$('Code: 組告警指紋').item.json.severity}] ${$('Code: 組告警指紋').item.json.alert_key} 首次/新窗口告警，已通知值班`, }) }}",
    "options": {}
   }
  },
  {
   "id": "n9",
   "name": "Respond: 已通知",
   "type": "n8n-nodes-base.respondToWebhook",
   "typeVersion": 1,
   "position": [
    1320,
