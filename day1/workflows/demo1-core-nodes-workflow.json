  "id": "DwlrvyHhh4TidZpZ",
  "name": "Demo 1 - 核心節點操作 [Webhook + Set + IF + Code + HTTP]",
  "description": null,
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "id": "d1-wh",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "demo-core",
        "options": {}
      },
      "webhookId": "551c9d42-39c2-45fe-b53c-9705fbdbb2fb"
    },
    {
      "id": "d1-set",
      "name": "Set: 整理欄位",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        460,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "fields": {
          "values": [
            {
              "name": "name",
              "type": "stringValue",
              "value": "={{ $json.body?.name    || $json.name    || 'Anonymous' }}"
            },
            {
              "name": "severity",
              "type": "stringValue",
              "value": "={{ $json.body?.severity || $json.severity || 'low' }}"
            },
            {
              "name": "source",
              "type": "stringValue",
              "value": "={{ $json.body?.source   || $json.source   || 'unknown' }}"
            }
          ]
        }
      }
    },
    {
      "id": "d1-if",
      "name": "IF: severity == critical?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.severity }}",
              "rightValue": "critical",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and",
          "options": {}
        },
        "options": {}
      }
    },
    {
      "id": "d1-code-high",
      "name": "Code: 高優先處理",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ],
      "parameters": {
        "jsCode": "// True 路徑 — 緊急處理\nreturn [{ json: {\n  ...$input.item.json,\n  action: 'ESCALATE',\n  message: '🚨 Critical: ' + $json.name + ' requires immediate attention',\n  timestamp: new Date().toISOString()\n}}];"
      }
    },
    {
      "id": "d1-code-low",
      "name": "Code: 一般記錄",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        440
      ],
      "parameters": {
        "jsCode": "// False 路徑 — 一般記錄\nreturn [{ json: {\n  ...$input.item.json,\n  action: 'LOG',\n  message: 'ℹ️ ' + $json.name + ' logged at ' + $json.severity,\n  timestamp: new Date().toISOString()\n}}];"
      }
    },
    {
      "id": "d1-http",
      "name": "HTTP Request: 送出通知",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=YOUR_GEMINI_API_KEY",
        "sendBody": true,
        "specifyBody": "json",
        "options": {
          "headers": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        },
        "jsonBody": "={{ { contents: [{ parts: [{ text: \"Summarize this action in one sentence: \" + $json.action + \" - \" + $json.message }] }] } }}"
      }
    },
    {
      "id": "d1-manual",
      "name": "Demo Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -20,
        500
      ],
      "parameters": {}
    },
    {
      "id": "d1-demo-payload",
      "name": "Demo Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        500
      ],
      "parameters": {
        "jsCode": "// 課堂示範用 payload（模擬 critical 告警）\nreturn [{ json: {\n  name:     \"HighCPU\",\n  severity: \"critical\",\n  source:   \"monitoring-agent\"\n} }];"
      }
    }
  ],
