    {
      "id": "d5-devices",
      "name": "Load: 多台設備狀態",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "jsCode": "// 模擬從 API 拿到的設備清單（多筆 items）\nreturn [\n  { json: { host: 'core-sw-01', cpu: 92, memory: 78, status: 'critical', region: 'fab-12' } },\n  { json: { host: 'core-sw-02', cpu: 45, memory: 60, status: 'ok',       region: 'fab-12' } },\n  { json: { host: 'dist-sw-03', cpu: 78, memory: 85, status: 'warning',  region: 'fab-14' } },\n  { json: { host: 'access-01',  cpu: 23, memory: 40, status: 'ok',       region: 'fab-14' } },\n  { json: { host: 'border-gw',  cpu: 88, memory: 92, status: 'critical', region: 'corp'   } },\n];"
      }
    },
    {
      "id": "d5-filter",
      "name": "Code: 過濾 Critical 設備",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        200
      ],
      "parameters": {
        "jsCode": "// $input.all() 拿到所有 items\nconst all = $input.all();\nconst critical = all.filter(item => item.json.status === 'critical');\nconsole.log('Total:', all.length, '| Critical:', critical.length);\nreturn critical;"
      }
    },
    {
      "id": "d5-summary",
      "name": "Code: 依 Region 彙整",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        440
      ],
      "parameters": {
        "jsCode": "// 用 reduce 把多筆 items 聚合成一筆報表\nconst all = $input.all();\nconst byRegion = all.reduce((acc, item) => {\n  const r = item.json.region;\n  if (!acc[r]) acc[r] = { region: r, total: 0, critical: 0, avgCpu: 0, cpuSum: 0 };\n  acc[r].total++;\n  acc[r].cpuSum += item.json.cpu;\n  if (item.json.status === 'critical') acc[r].critical++;\n  return acc;\n}, {});\n\nreturn Object.values(byRegion).map(r => ({\n  json: { ...r, avgCpu: Math.round(r.cpuSum / r.total) }\n}));"
      }
    },
    {
      "id": "d5-merge",
      "name": "Merge: 合併兩路結果",
